// API suffix, SpeciesMetadata member, invalid-index fallback
CATCHEM_SPECIES_DOUBLE_PROPERTY(density, density, 0.0)
CATCHEM_SPECIES_DOUBLE_PROPERTY(radius, radius, 0.0)
CATCHEM_SPECIES_DOUBLE_PROPERTY(lower_radius, lower_radius, 0.0)
CATCHEM_SPECIES_DOUBLE_PROPERTY(upper_radius, upper_radius, 0.0)
CATCHEM_SPECIES_DOUBLE_PROPERTY(viscosity, viscosity, 0.0)
CATCHEM_SPECIES_BOOL_PROPERTY(is_tracer, is_tracer)
CATCHEM_SPECIES_BOOL_PROPERTY(is_advected, is_advected)
CATCHEM_SPECIES_BOOL_PROPERTY(is_photolysis, is_photolysis)
CATCHEM_SPECIES_DOUBLE_PROPERTY(dd_f0, dd_f0, 0.0)
CATCHEM_SPECIES_DOUBLE_PROPERTY(dd_hstar, dd_hstar, 0.0)
CATCHEM_SPECIES_DOUBLE_PROPERTY(dd_DvzAerSnow, dd_DvzAerSnow, 0.0)
CATCHEM_SPECIES_DOUBLE_PROPERTY(dd_DvzMinVal_snow, dd_DvzMinVal_snow, 0.0)
CATCHEM_SPECIES_DOUBLE_PROPERTY(dd_DvzMinVal_land, dd_DvzMinVal_land, 0.0)
CATCHEM_SPECIES_DOUBLE_PROPERTY(henry_k0, henry_k0, 0.0)
CATCHEM_SPECIES_DOUBLE_PROPERTY(henry_cr, henry_cr, 0.0)
CATCHEM_SPECIES_DOUBLE_PROPERTY(henry_pKa, henry_pKa, 0.0)
CATCHEM_SPECIES_DOUBLE_PROPERTY(wd_retfactor, wd_retfactor, 0.0)
CATCHEM_SPECIES_BOOL_PROPERTY(wd_LiqAndGas, wd_LiqAndGas)
CATCHEM_SPECIES_DOUBLE_PROPERTY(wd_convfacI2G, wd_convfacI2G, 0.0)
CATCHEM_SPECIES_DOUBLE_PROPERTY(wd_reevap_frac, wd_reevap_frac, 0.5)
CATCHEM_SPECIES_DOUBLE_PROPERTY(t_chem_loss, t_chem_loss, -1.0)
CATCHEM_SPECIES_DOUBLE_PROPERTY(BackgroundVV, BackgroundVV, 1.0e-20)

// Compatibility APIs use the older catchem_state_is_species_* spelling.
CATCHEM_SPECIES_LEGACY_BOOL_PROPERTY(dust, is_dust)
CATCHEM_SPECIES_LEGACY_BOOL_PROPERTY(seasalt, is_seasalt)
CATCHEM_SPECIES_LEGACY_BOOL_PROPERTY(drydep, is_drydep)
CATCHEM_SPECIES_LEGACY_BOOL_PROPERTY(wetdep, is_wetdep)
