<para>Scheme parameters (pre-validated by host) </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">g0</parametername>
</parameternamelist>
<parameterdescription>
<para>Required constant from Constants module </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">year</parametername>
</parameternamelist>
<parameterdescription>
<para>Time parameter from TimeState (year) </para>
</parameterdescription>
</parameteritem>
<parameteritem>
