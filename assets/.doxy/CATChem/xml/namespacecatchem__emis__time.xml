      <memberdef kind="function" id="namespacecatchem__emis__time_1ae567ffba717fe634c4ad2376cf1f87f6" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>pure subroutine, public</type>
        <definition>pure subroutine, public catchem_emis_time::catchem_emis_file_time_bracket</definition>
        <argsstring>(curr_key, curr_dn, n, tc_dates, tc_secs, lo_rec, w_next)</argsstring>
        <name>catchem_emis_file_time_bracket</name>
        <qualifiedname>catchem_emis_time::catchem_emis_file_time_bracket</qualifiedname>
        <param>
          <type>integer(8), intent(in)</type>
          <defname>curr_key</defname>
        </param>
        <param>
          <type>real(fp), intent(in)</type>
          <defname>curr_dn</defname>
        </param>
        <param>
          <type>integer, intent(in)</type>
          <defname>n</defname>
        </param>
        <param>
          <type>integer, dimension(:), intent(in)</type>
          <defname>tc_dates</defname>
        </param>
        <param>
          <type>integer, dimension(:), intent(in)</type>
          <defname>tc_secs</defname>
        </param>
        <param>
          <type>integer, intent(out)</type>
          <defname>lo_rec</defname>
        </param>
        <param>
          <type>real(fp), intent(out)</type>
          <defname>w_next</defname>
        </param>
        <briefdescription>
<para>Monthly bracket anchored at the file&apos;s actual record timestamps. </para>
        </briefdescription>
        <detaileddescription>
<para>Selects the lower bracketing record (1-based) and the upper-record weight from a multi-record climatology, honouring the records&apos; own time coordinate. Two regimes:<itemizedlist>
<listitem><para>spanning file: the current datetime key lies within [first,last] record. Bracket by the records&apos; real datetime (integer key = date*1e5 + secs, so it is strictly ordered). Needed for files that repeat months, e.g. the padded 14-record GMI oxidant file.</para>
</listitem><listitem><para>cyclic climatology: the current time is OUTSIDE the file&apos;s years (a 12-record climatology used in a later run), or no current key is supplied (CATCHEM_EMIS_NO_KEY). Bracket by day-of-year, wrapping Dec-&gt;Jan. The upper record used downstream is lo_rec+1 (wrapping to 1 for the cyclic Dec-&gt;Jan case). The weight itself is delegated to catchem_emis_time_weight.</para>
</listitem></itemizedlist>
</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">curr_key</parametername>
</parameternamelist>
<parameterdescription>
<para>current datetime key (yyyymmdd*1e5 + secs) or NO_KEY </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">curr_dn</parametername>
</parameternamelist>
<parameterdescription>
<para>current fractional day-of-year </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">n</parametername>
</parameternamelist>
<parameterdescription>
<para>number of records </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">tc_dates</parametername>
</parameternamelist>
<parameterdescription>
<para>yyyymmdd for each record </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">tc_secs</parametername>
</parameternamelist>
<parameterdescription>
<para>seconds-of-day for each record </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="out">lo_rec</parametername>
</parameternamelist>
<parameterdescription>
<para>1-based lower bracketing record index </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="out">w_next</parametername>
</parameternamelist>
<parameterdescription>
<para>weight of the upper record, clamped to [0,1] </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
