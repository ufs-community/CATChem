# =====================================================================
# CATChem standalone driver configuration (ESMF_Config format)
# =====================================================================
# This file controls the standalone ESMF/NUOPC driver:
#   - the top-level clock (start/stop time and time step)
#   - the grid (single column or regular lat-lon)
#   - the paths to the CATChem science configuration (YAML)
#
# The CATChem *science* configuration (processes, species, emissions, ...)
# stays in its own YAML file referenced by `catchem_config_file:` below.
#
# Usage:
#   mpirun -np 1 catchem_app catchem_standalone.configure
# =====================================================================

# --- Clock control --------------------------------------------------
# ISO 8601 date-time strings: YYYY-MM-DDThh:mm:ss
start_time:        2020-01-01T00:00:00
stop_time:         2020-01-01T06:00:00
timestep_seconds:  3600

# --- CATChem science configuration (YAML, consumed by the cap) ------
catchem_config_file:  CATChem_new_config.yml
# field_mapping_file is only needed for coupled runs that exchange fields with
# other components. A single standalone CATChem model does not need it, so it
# is left unset here. Uncomment to use one.
# field_mapping_file:   CATChem_field_mapping.yml

# --- Grid configuration ---------------------------------------------
# grid_mode: "column" for a single column (1 x 1)
#            "gridded" for a regular lat-lon grid (grid_nx x grid_ny)
grid_mode:  column

# Number of vertical levels. NOTE: the vertical is an ungridded dimension on
# the fields, not part of the ESMF horizontal grid. This count is stamped onto
# the grid as metadata so the cap realizes fields with the right number of
# levels.
grid_nz:    72

# Single-column location (used when grid_mode = column)
column_lon:  0.0
column_lat:  0.0

# Horizontal grid (used when grid_mode = gridded)
grid_nx:        72
grid_ny:        36
grid_lon_start: 0.0
grid_lon_end:   360.0
grid_lat_start: -90.0
grid_lat_end:   90.0

# --- Run sequence (optional) ----------------------------------------
# With a single component the default run sequence is sufficient, so this
# block is commented out. Uncomment and extend when adding more components
# (e.g. a data/forcing component or a mediator).
#
# runSeq::
#   @3600
#     CATCHEM
#   @
# ::
